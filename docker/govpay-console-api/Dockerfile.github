FROM eclipse-temurin:25-jre-alpine

ARG govpay_console_api_fullversion
# sha256 del jar della release: la pipeline lo calcola dall'artifact della
# build, build_image.sh lo legge dalle API delle release di GitHub.
ARG govpay_console_api_sha256
ARG govpay_console_api_home=/opt/govpay-console-api
ARG govpay_console_api_log=/var/log/govpay-console-api

LABEL maintainer="Link.it s.r.l."
LABEL description="GovPay Console REST API"
LABEL govpay.console-api.version="${govpay_console_api_fullversion}"
USER root

ENV GOVPAY_CONSOLE_API_FULLVERSION=${govpay_console_api_fullversion} \
GOVPAY_CONSOLE_API_LOGDIR=${govpay_console_api_log} \
GOVPAY_CONSOLE_API_HOME=${govpay_console_api_home} \
TZ=Europe/Rome


RUN set -eux; \
apk update; \
apk upgrade; \
# Solo cio' che serve a runtime: bash per l'entrypoint, tzdata per il fuso
# orario. tar, unzip, netcat e curl non sono usati dall'entrypoint, e ogni
# pacchetto in piu' e' superficie esposta e segnalazioni della scansione.
apk add --no-cache bash tzdata; \
rm -rf /var/cache/apk/*; \
echo "${TZ}" > /etc/timezone; \
addgroup -S govpay ; \
adduser -S -G govpay govpay; \
mkdir -p ${GOVPAY_CONSOLE_API_HOME} ${GOVPAY_CONSOLE_API_LOGDIR} /opt/sql /opt/jdbc-drivers; \
chown -R govpay:govpay ${GOVPAY_CONSOLE_API_HOME} ${GOVPAY_CONSOLE_API_LOGDIR} /opt/sql

WORKDIR ${GOVPAY_CONSOLE_API_HOME}

# Download del jar dalla release GitHub, con verifica del certificato e del
# checksum: senza checksum l'immagine conterrebbe qualunque file venisse
# servito a quell'indirizzo. curl serve solo qui: installato e rimosso nello
# stesso passo, non resta nell'immagine.
RUN set -eux; \
apk add --no-cache --virtual .download curl; \
test -n "${govpay_console_api_sha256}" || { echo "Manca il build-arg govpay_console_api_sha256 (sha256 del jar della release)"; exit 1; }; \
curl -fL -sS -o /opt/govpay-console-api/govpay-console-api.jar "https://github.com/link-it/govpay-console-api/releases/download/${GOVPAY_CONSOLE_API_FULLVERSION}/govpay-console-api-${GOVPAY_CONSOLE_API_FULLVERSION}.jar"; \
echo "${govpay_console_api_sha256}  /opt/govpay-console-api/govpay-console-api.jar" | sha256sum -c -; \
apk del .download


# Copy entrypoint and initialization scripts
COPY commons/entrypoint.sh /usr/local/bin/
RUN chown -R govpay:0 /usr/local/bin/entrypoint.sh ${GOVPAY_CONSOLE_API_HOME} ${GOVPAY_CONSOLE_API_LOGDIR} \
&& chmod -Rf g+rwX ${GOVPAY_CONSOLE_API_HOME} ${GOVPAY_CONSOLE_API_LOGDIR} \
&& chmod ug=rx /usr/local/bin/entrypoint.sh



USER govpay

# CONSOLE_TIME_ZONE e' la forma a variabile di console.time-zone (fuso orario
# delle date nelle risposte JSON).
ENV CONSOLE_TIME_ZONE=Europe/Rome \
    SPRING_DATASOURCE_HIKARI_CONNECTION_TIMEOUT=20000 \
    SPRING_DATASOURCE_HIKARI_IDLE_TIMEOUT=10000 \
    SPRING_DATASOURCE_HIKARI_MAX_LIFETIME=600000 \
    LOGGING_FILE_NAME=${GOVPAY_CONSOLE_API_LOGDIR}/govpay-console-api.log


ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
CMD []
